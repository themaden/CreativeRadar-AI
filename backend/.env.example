PROJECT_NAME="CreativeRadar AI"
API_V1_STR="/api/v1"
DEBUG=True

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=creativeradar_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/creativeradar_db

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=ad_embeddings

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI APIs
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Meta & TikTok Scraper API Keys
META_AD_LIBRARY_TOKEN=your_meta_token_here
TIKTOK_CREATIVE_CENTER_TOKEN=your_tiktok_token_here
